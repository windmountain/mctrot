{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "serverTs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Server clock, ms since epoch"
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ts": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "When the phone recorded it, ms since epoch"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "accuracy": {
              "description": "Horizontal accuracy in metres",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "ts",
            "lat",
            "lon",
            "accuracy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The latest recorded point; null before any"
    },
    "attempt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "startedAt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Started, ms since epoch"
            },
            "endedAt": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Stopped, ms since epoch"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null while the attempt is running"
            }
          },
          "required": [
            "id",
            "startedAt",
            "endedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The running attempt, or else the most recent; null before any"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "description": "The route plan's stores"
    },
    "track": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "description": "The path walked as [lat, lon] lines, simplified, split where GPS was lost: this attempt's, or the last day's before any attempt"
    },
    "visits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "matched"
              },
              "storeId": {
                "type": "string"
              },
              "distanceM": {
                "type": "number",
                "description": "From my position at the tap to the store"
              }
            },
            "required": [
              "tapTs",
              "status",
              "storeId",
              "distanceM"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "pending",
                "description": "Waiting for GPS from after the tap"
              }
            },
            "required": [
              "tapTs",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "unmatched",
                "description": "No store near, or no GPS near the tap"
              }
            },
            "required": [
              "tapTs",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "This attempt's Visit taps in time order, each matched to a store by GPS"
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "When I made it, ms since epoch"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "photo",
              "video",
              "voice",
              "pair"
            ]
          },
          "text": {
            "description": "A text post's text",
            "type": [
              "string",
              "null"
            ]
          },
          "media": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Photo: full size; video: .mp4; voice: .m4a; pair: the cut in its order"
                  },
                  "thumbUrl": {
                    "description": "Photo: about 400 px",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "posterUrl": {
                    "description": "Video: a frame",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "durationMs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "url",
                  "thumbUrl",
                  "posterUrl",
                  "width",
                  "height",
                  "durationMs"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for text posts"
          },
          "pair": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "string",
                    "enum": [
                      "AB",
                      "BA"
                    ],
                    "description": "Which camera comes first"
                  },
                  "a": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "The clip's .mp4"
                      },
                      "posterUrl": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "url",
                      "posterUrl"
                    ],
                    "additionalProperties": false
                  },
                  "b": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "The clip's .mp4"
                      },
                      "posterUrl": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "url",
                      "posterUrl"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "order",
                  "a",
                  "b"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "A DoubleTake pair's two clips (A and B cameras), for a side-by-side player; null otherwise"
          },
          "at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  }
                },
                "required": [
                  "lat",
                  "lon"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Where I was, from the GPS track; null when unknown"
          }
        },
        "required": [
          "id",
          "ts",
          "type",
          "text",
          "media",
          "pair",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "The newest posts first; photos, video, voice and DoubleTake pairs once processed"
    },
    "weather": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "place": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "lat",
                "lon"
              ],
              "additionalProperties": false,
              "description": "Where all weather and sun times are for"
            },
            "observedAt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "The reading's own time (Open-Meteo updates every 15 minutes), ms since epoch"
            },
            "fetchedAt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "When the recorder fetched it, ms since epoch"
            },
            "temperatureF": {
              "type": [
                "number",
                "null"
              ]
            },
            "feelsLikeF": {
              "type": [
                "number",
                "null"
              ]
            },
            "humidityPct": {
              "type": [
                "number",
                "null"
              ]
            },
            "precipitationIn": {
              "description": "In the reading's 15 minutes",
              "type": [
                "number",
                "null"
              ]
            },
            "summary": {
              "description": "From the WMO weather code: \"Light rain\"",
              "type": [
                "string",
                "null"
              ]
            },
            "cloudCoverPct": {
              "type": [
                "number",
                "null"
              ]
            },
            "windMph": {
              "type": [
                "number",
                "null"
              ]
            },
            "gustMph": {
              "type": [
                "number",
                "null"
              ]
            },
            "windFrom": {
              "description": "Compass point the wind blows from: \"NW\"",
              "type": [
                "string",
                "null"
              ]
            },
            "isDay": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "place",
            "observedAt",
            "fetchedAt",
            "temperatureF",
            "feelsLikeF",
            "humidityPct",
            "precipitationIn",
            "summary",
            "cloudCoverPct",
            "windMph",
            "gustMph",
            "windFrom",
            "isDay"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The latest weather reading in central Manhattan; null before the first"
    },
    "sun": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Today in New York, YYYY-MM-DD"
        },
        "astronomicalDawn": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Sun 18° below the horizon, rising, ms since epoch; null if it doesn't happen that day"
        },
        "nauticalDawn": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "12° below, rising, ms since epoch; null if it doesn't happen that day"
        },
        "civilDawn": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "6° below, rising, ms since epoch; null if it doesn't happen that day"
        },
        "sunrise": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Sunrise, ms since epoch; null if it doesn't happen that day"
        },
        "solarNoon": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The sun at its highest, ms since epoch"
        },
        "sunset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Sunset, ms since epoch; null if it doesn't happen that day"
        },
        "civilDusk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "6° below, setting, ms since epoch; null if it doesn't happen that day"
        },
        "nauticalDusk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "12° below, setting, ms since epoch; null if it doesn't happen that day"
        },
        "astronomicalDusk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "18° below, setting, ms since epoch; null if it doesn't happen that day"
        }
      },
      "required": [
        "date",
        "astronomicalDawn",
        "nauticalDawn",
        "civilDawn",
        "sunrise",
        "solarNoon",
        "sunset",
        "civilDusk",
        "nauticalDusk",
        "astronomicalDusk"
      ],
      "additionalProperties": false,
      "description": "Sun times for today in New York, at the weather's place"
    },
    "sky": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The minute it's for, ms since epoch"
        },
        "sun": {
          "type": "object",
          "properties": {
            "elevation": {
              "type": "number",
              "description": "Degrees above the horizon; negative below"
            },
            "azimuth": {
              "type": "number",
              "description": "Compass bearing, 0 north, 90 east"
            }
          },
          "required": [
            "elevation",
            "azimuth"
          ],
          "additionalProperties": false
        },
        "squares": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Where to look: \"Low in the SW, toward the sun\""
              },
              "elevation": {
                "type": "number"
              },
              "azimuth": {
                "type": "number"
              },
              "color": {
                "type": "string",
                "description": "CSS hex colour"
              }
            },
            "required": [
              "label",
              "elevation",
              "azimuth",
              "color"
            ],
            "additionalProperties": false
          }
        },
        "dome": {
          "type": "object",
          "properties": {
            "overhead": {
              "type": "string",
              "description": "CSS hex colour"
            },
            "north": {
              "type": "string",
              "description": "CSS hex colour"
            },
            "east": {
              "type": "string",
              "description": "CSS hex colour"
            },
            "south": {
              "type": "string",
              "description": "CSS hex colour"
            },
            "west": {
              "type": "string",
              "description": "CSS hex colour"
            }
          },
          "required": [
            "overhead",
            "north",
            "east",
            "south",
            "west"
          ],
          "additionalProperties": false,
          "description": "Overhead, and each compass point 10° above the horizon: the whole sky for a gradient"
        }
      },
      "required": [
        "at",
        "sun",
        "squares",
        "dome"
      ],
      "additionalProperties": false,
      "description": "The sky's colour in a few directions, simulated from the sun and the latest weather (src/sky.ts)"
    }
  },
  "required": [
    "serverTs",
    "position",
    "attempt",
    "stores",
    "track",
    "visits",
    "posts",
    "weather",
    "sun",
    "sky"
  ],
  "additionalProperties": false,
  "title": "McTrot /live response"
}
