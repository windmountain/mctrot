{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "serverTs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Server clock, ms since epoch"
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ts": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "When the phone recorded it, ms since epoch"
            },
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "accuracy": {
              "description": "Horizontal accuracy in metres",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "ts",
            "lat",
            "lon",
            "accuracy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The latest recorded point; null before any"
    },
    "attempt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "startedAt": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Started, ms since epoch"
            },
            "endedAt": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Stopped, ms since epoch"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Null while the attempt is running"
            }
          },
          "required": [
            "id",
            "startedAt",
            "endedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The running attempt, or else the most recent; null before any"
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "description": "The route plan's stores"
    },
    "visits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "matched"
              },
              "storeId": {
                "type": "string"
              },
              "distanceM": {
                "type": "number",
                "description": "From my position at the tap to the store"
              }
            },
            "required": [
              "tapTs",
              "status",
              "storeId",
              "distanceM"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "pending",
                "description": "Waiting for GPS from after the tap"
              }
            },
            "required": [
              "tapTs",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tapTs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "When I tapped Visit, ms since epoch"
              },
              "status": {
                "type": "string",
                "const": "unmatched",
                "description": "No store near, or no GPS near the tap"
              }
            },
            "required": [
              "tapTs",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "This attempt's Visit taps in time order, each matched to a store by GPS"
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "When I made it, ms since epoch"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "photo",
              "video",
              "voice"
            ]
          },
          "text": {
            "description": "A text post's text",
            "type": [
              "string",
              "null"
            ]
          },
          "media": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Photo: full size; video: .mp4; voice: .m4a"
                  },
                  "thumbUrl": {
                    "description": "Photo: about 400 px",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "posterUrl": {
                    "description": "Video: a frame",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "durationMs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "url",
                  "thumbUrl",
                  "posterUrl",
                  "width",
                  "height",
                  "durationMs"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for text posts"
          },
          "at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lon": {
                    "type": "number"
                  }
                },
                "required": [
                  "lat",
                  "lon"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Where I was, from the GPS track; null when unknown"
          }
        },
        "required": [
          "id",
          "ts",
          "type",
          "text",
          "media",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "The newest posts first; photos, video and voice once processed"
    }
  },
  "required": [
    "serverTs",
    "position",
    "attempt",
    "stores",
    "visits",
    "posts"
  ],
  "additionalProperties": false,
  "title": "McTrot /live response"
}
