# Netlify: /live's old views (/live/map, /live/blog, /live/timeline,
# /live/stats) all show live.html, which points to the replay. 200: serve
# it there, without a redirect.
/live/*  /live.html  200

# The McTrot 5 replay (archive/2026-11-21/index.html) routes its own views
# too (/archive/2026-11-21/map, /blog, /timeline, /stats). Its archive.json,
# og.png and media/ are real files there, which a rewrite never shadows.
/archive/2026-11-21/*  /archive/2026-11-21/index.html  200
